# Optional: LLM for title/metaphor interpretation (server side only, see README).
# Without these the app uses the built-in rule-based matcher.
LLM_BASE_URL=https://your-openai-compatible-host/v1
LLM_API_KEY=
# Header that carries the key; leave empty for "Authorization: Bearer <key>".
LLM_API_KEY_HEADER=
FORMA_LLM_MODEL=claude-haiku-5-5
